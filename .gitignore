node_modules/
.uploads/
.shots/
projects.json

# 构建产物
build/
dist-app/

# 安装程序 / 便携版。上百 MB，不要进仓库 ——
# 要分发就走 GitHub Release 的附件，别用 git 传二进制。
dist-installer/

# 正式发布目录：只放要上传 GitHub Release 的那三个文件
# （Pi-GUI-Setup-<v>.exe / Pi-GUI-<v>-portable.zip / SHA256SUMS.txt）。
# 由 npm run release:collect 从 dist-installer 收集而来，同样是可再生的产物。
dist-release/

# 排查问题时随手写的小探针，不是项目的一部分
.probe/

# 助手在本机攒的工作记忆（架构要点、协议约束、验收基线）。
# 只对本机有意义，换个环境就不成立，所以不进仓库。
.workbuddy-ai/

# clearDir 在删不掉时把旧目录改名留下的残骸
*.trash-*
