<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:automatic-styles>
  <style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties presentation:background-visible="true"/></style:style>
  <style:style style:name="box1" style:family="graphic"><style:graphic-properties draw:fill="none" draw:stroke="none" fo:padding="0.05in"/></style:style>
  <style:style style:name="t1" style:family="text"><style:text-properties fo:font-size="18pt" style:font-name-asian="Microsoft YaHei"/></style:style>
  <style:list-style style:name="bullet1"><text:list-level-style-bullet text:level="1" text:bullet-char="•"><style:list-level-properties text:min-label-width="0.25in"/><text:list-level-style-bullet text:level="2" text:bullet-char="◦"><style:list-level-properties text:min-label-width="0.5in"/></text:list-level-style-bullet></text:list-level-style-bullet></style:list-style>
  <style:list-style style:name="num1"><text:list-level-style-number text:level="1" style:num-format="1"/><text:list-level-style-number text:level="2" style:num-format="a"/></style:list-style>
 </office:automatic-styles>
 <office:body><office:presentation>
  <draw:page draw:name="page1" draw:style-name="dp1" draw:master-page-name="Default" presentation:presentation-page-layout-name="AL1">
   <draw:frame draw:style-name="box1" svg:x="0.5in" svg:y="0.5in" svg:width="9in" svg:height="1in" draw:z-index="0"><draw:text-box><text:p text:style-name="t1">F6 真实软件兼容性验证 / Real-software compatibility</text:p></draw:text-box></draw:frame>
   <draw:frame draw:style-name="box1" svg:x="0.5in" svg:y="1.8in" svg:width="9in" svg:height="4in" draw:z-index="1"><draw:text-box>
    <text:list text:style-name="bullet1"><text:list-item><text:p text:style-name="t1">第一层项目符号 first level</text:p></text:list-item><text:list-item><text:list><text:list-item><text:p text:style-name="t1">第二层嵌套 nested level 2</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="t1">回到第一层 back to level 1</text:p></text:list-item></text:list>
    <text:list text:style-name="num1"><text:list-item><text:p text:style-name="t1">编号第一项 numbered one</text:p></text:list-item><text:list-item><text:p text:style-name="t1">编号第二项 numbered two</text:p></text:list-item><text:list-item><text:list><text:list-item><text:p text:style-name="t1">字母子项 alpha child</text:p></text:list-item></text:list></text:list-item></text:list>
    <text:p text:style-name="t1">普通段落 plain paragraph，中文混排 CJK mixed 123</text:p>
   </draw:text-box></draw:frame>
  </draw:page>
  <draw:page draw:name="page2" draw:style-name="dp1" draw:master-page-name="Default" presentation:presentation-page-layout-name="AL1">
   <draw:frame draw:style-name="box1" svg:x="0.5in" svg:y="0.5in" svg:width="9in" svg:height="5in" draw:z-index="0"><draw:text-box>
    <text:p text:style-name="t1">第二页：间距与多级 Second page: spacing and levels</text:p>
    <text:list text:style-name="num1"><text:list-item><text:p text:style-name="t1">甲</text:p></text:list-item><text:list-item><text:p text:style-name="t1">乙</text:p></text:list-item><text:list-item><text:p text:style-name="t1">丙</text:p></text:list-item></text:list>
   </draw:text-box></draw:frame>
  </draw:page>
 </office:presentation></office:body>
</office:document>
